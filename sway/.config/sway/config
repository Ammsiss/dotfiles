# Read `man 5 sway` for a complete reference.

### Startup

exec qalculate-gtk
for_window [app_id="qalculate"] floating enable, resize set width 450 px height 250 px, move scratchpad

### Variables

set $mod Mod4

set $left h
set $down j
set $up k
set $right l

set $term foot
set $rofi_cmd rofi -terminal '$term'
set $menu $rofi_cmd -show combi -combi-modes drun

set $rofi_prompt_cmd rofi -dmenu -p name -theme-str \
    "listview { enabled: false; } window { width: 30%; }"

### Window settings

default_border pixel 0
default_floating_border pixel 0

gaps inner 0
gaps outer 0

client.focused          #282828 #282828 #ebdbb2 #5f8787 #af5f00
client.focused_inactive #45475a #1e1e2e #cdd6f4 #45475a #45475a

for_window [app_id="foot"] border pixel 3
for_window [app_id="imv"] border pixel 3

for_window [app_id="Thunar"] floating enable, resize set width 1000 px height 550 px
for_window [app_id="qalculate"] floating enable, resize set width 450 px, height 250 px
for_window [app_id="imv"] floating enable, move position center

### Outputs

set $desk DP-1
output $desk {
    pos 0 0
    resolution 2560x1440@180Hz
    bg /home/juta/.local/share/backgrounds/sway/minimal-orange-bg-1440p.jpg fill
}

set $tv HDMI-A-2
output $tv {
    # so you can't "lose" the mouse
    pos 5000 0
    resolution 3840x2160@120Hz
    scale 1.5
    bg /home/juta/.local/share/backgrounds/sway/minimal-orange-bg-1440p.jpg fill
}

set $location $desk

## Toggle between locations
bindsym $mod+t set $$location $tv
bindsym $mod+d set $$location $desk

## Move to a workspace
bindsym $mod+1 workspace number 1; move workspace to output $$location
bindsym $mod+2 workspace number 2; move workspace to output $$location
bindsym $mod+3 workspace number 3; move workspace to output $$location
bindsym $mod+4 workspace number 4; move workspace to output $$location
bindsym $mod+5 workspace number 5; move workspace to output $$location
bindsym $mod+6 workspace number 6; move workspace to output $$location
bindsym $mod+7 workspace number 7; move workspace to output $$location
bindsym $mod+8 workspace number 8; move workspace to output $$location
bindsym $mod+9 workspace number 9; move workspace to output $$location
bindsym $mod+0 workspace number 10; move workspace to output $$location
bindsym $mod+m workspace m; move workspace to output $$location

## Move container to a workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10
bindsym $mod+Shift+m move container to workspace m

### Inputs

input "type:pointer" {
    accel_profile "flat"
    pointer_accel -0.2
}

input "1133:45975:Logitech_K250" {
    xkb_options caps:escape,altwin:swap_lalt_lwin
}

input "type:keyboard" {
    repeat_delay 225
    repeat_rate 25
}

### Binds

## Misc
bindsym $mod+Shift+r reload
bindsym $mod+Return exec $term --hold
bindsym $mod+space exec $menu
bindsym $mod+x kill

# normal - drag + left click, moves float
#        - drag + right click = resizes float)
floating_modifier $mod normal

bindsym $mod+f floating toggle
bindsym $mod+Shift+f fullscreen

# sticky floats "stick" when changing workspaces
bindsym $mod+s sticky toggle

# shifts focus from floating wins to tiled wins
bindsym $mod+a focus mode_toggle

## Split binds
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+e layout toggle split

# Resizing splits
bindsym $mod+r mode "resize"
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $right resize grow width 10px
    bindsym $down resize shrink height 10px
    bindsym $up resize grow height 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

## Notifications
bindsym $mod+Shift+d exec dunstctl history-pop
bindsym $mod+Shift+c exec dunstctl close-all
bindsym $mod+Shift+e exec dunstctl context

## Screenshots
bindsym $mod+Shift+Control+p exec grimshot copy area
bindsym $mod+Shift+p exec sh -c 'f=$($rofi_prompt_cmd); \
    [ -n "$f" ] && grimshot save area "$HOME/Pictures/$f.png"'

## Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Include configs from 3 locations:
#
#  - /usr/share/sway/config.d
#  - /etc/sway/config.d
#  - $XDG_CONFIG_HOME/sway/config.d ($HOME/.config/sway/config.d)
#
# If multiple directories contain the files with the same name, the later
# directory takes precedence; `$XDG_CONFIG_HOME/sway/config.d/20-swayidle.conf`
# will always be loaded instead of `/usr/share/sway/config.d/20-swayidle.conf`
# or `/etc/sway/config.d/20-swayidle.conf`
#
# This mechanism permits overriding our default configuration per-system
# (/etc) or per-user ($XDG_CONFIG_HOME) basis. Just create the file you
# want to modify/override in the higher-level directory.
#
# For example, to disable the default bar from Fedora configs, you'll need to
#     $ echo -n > "$HOME/.config/sway/config.d/90-bar.conf"
#
# Note the quoting, the $() and the arguments quoting. All the parts are equally
# important to make the magic work. And if you want to learn the secret behind
# the trick, it's all in the `wordexp(3)`.

include '$(/usr/libexec/sway/layered-include "/usr/share/sway/config.d/*.conf" "/etc/sway/config.d/*.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d/*.conf")'

### Startup apps
workspace m
exec firefox

workspace number 1
exec foot

workspace number 9
exec okular

### No auto sleep
exec_always sh -c 'pkill -x swayidle || true'
